{
  "name": "google-voice-guide",
  "private": true,
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "adk:sync": "uv sync --project apps/adk",
    "adk:dev": "uv run --project apps/adk uvicorn app.main:app --reload --host 0.0.0.0 --port 8001",
    "dev": "./scripts/dev.sh",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  }
}
